    "@types/react-dom": "^19.1.9",
    "auth-mini-react-components": "^0.6.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "auth-mini": "^0.4.6"
