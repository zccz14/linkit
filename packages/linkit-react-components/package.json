{
  "name": "linkit-react-components",
  "version": "0.1.3",
  "description": "Authenticated Linkit provider and compact React display primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zccz14/linkit.git",
    "directory": "packages/linkit-react-components"
  },
  "homepage": "https://github.com/zccz14/linkit/tree/main/packages/linkit-react-components#readme",
  "bugs": {
    "url": "https://github.com/zccz14/linkit/issues"
  },
  "type": "module",
  "files": [
